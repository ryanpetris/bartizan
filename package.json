{
  "name": "bartizan",
  "version": "0.0.0",
  "private": true,
  "description": "SSH terminals and remote browsing",
  "homepage": "https://github.com/ryanpetris/bartizan",
  "author": "Bartizan contributors",
  "license": "MIT",
  "main": "out/main/main.cjs",
  "desktopName": "bartizan.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/program-text.mjs --test tests/*.test.ts",
    "rigs": "node scripts/rigs.mjs",
    "start": "npm run build && electron .",
    "postinstall": "install-electron",
    "web": "npm run build && node out/main/server.cjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  }
}
