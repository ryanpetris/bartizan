#!/usr/bin/make -f

%:
	dh $@ --buildsystem=none

execute_after_dh_install:
	install -Dm644 payload/bartizan.desktop debian/bartizan/usr/share/applications/bartizan.desktop
	install -Dm644 payload/bartizan.png debian/bartizan/usr/share/icons/hicolor/512x512/apps/bartizan.png
	install -Dm644 debian/bartizan.apparmor debian/bartizan/etc/apparmor.d/bartizan
	dh_apparmor --profile-name=bartizan

# Preserve the supplied Electron and native module binaries.
override_dh_strip:
override_dh_dwz:

override_dh_makeshlibs:
	dh_makeshlibs -n

override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/bartizan/opt/bartizan

execute_after_dh_fixperms:
	chmod 4755 debian/bartizan/opt/bartizan/chrome-sandbox
	find debian/bartizan -exec touch --no-dereference --date="@$$SOURCE_DATE_EPOCH" {} +
